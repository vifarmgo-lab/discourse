<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lộ trình chuyên gia · VNBot Community</title><link rel="stylesheet" href="/lo-trinh/assets/style.css"></head><body>
<header><a href="/">← VNBot Community</a><% if @actor %><a href="/lo-trinh?tab=me"><%= @actor.username %></a><% else %><a href="/login?redirect=/lo-trinh">Đăng nhập</a><% end %></header>
<main><h1>Lộ trình chuyên gia</h1>
<nav aria-label="Lộ trình"><% tabs={"start"=>"Các hạng","me"=>"Tiến độ của tôi","trials"=>"Tìm người dùng thử","verified"=>"Đã kiểm chứng","directory"=>"Danh bạ chuyên gia","events"=>"Buổi thực hành"}; tabs["briefs"]="Đề bài doanh nghiệp" if @level>=3 || @actor&.staff?; tabs["review"]="Xét duyệt" if @actor&.staff? %>
<% tabs.each do |k,v| %><a href="/lo-trinh?tab=<%= k %>" aria-current="<%= @tab==k ? 'page' : 'false' %>"><%= v %></a><% end %></nav>
<% if params[:done]=="1" %><p role="status">Đã ghi nhận thao tác của bạn.</p><% end %>
<% case @tab; when "start" %>
<p>Đăng giải pháp bạn đã làm, tìm người thử lại và dùng kết quả thực tế để xét danh hiệu.</p>
<div class="levels"><% VnRank::NAMES.each_with_index do |n,i| %><section><h2><%= n %></h2><p><%= VnRank::RULES[i] %></p><strong>Quyền lợi</strong><p><%= VnRank::BENEFITS[i] %></p></section><% end %></div>
<h2>Bắt đầu với một workflow</h2><p><a href="https://vnbot.run/help/">Hướng dẫn dùng VNBot</a> · <a href="/c/kho-skill-workflow/8">Kho skill &amp; workflow</a> · <a href="/c/da-lam-voi-vnbot/7">Đã làm với VNBot</a></p>
<details open><summary>Thử thách đầu tiên · Nhắc việc trước hạn</summary><ol><li>Tạo ba đầu việc thử, mỗi việc có người phụ trách, hạn và trạng thái.</li><li>Cho bot đọc danh sách và liệt kê việc còn mở sắp đến hạn. Dùng dữ liệu mẫu để thử cả trường hợp đã hoàn thành.</li><li>Đăng đầu vào mẫu, các bước làm, demo và kết quả ở chuyên mục Đã làm với VNBot. Sau đó nộp link bài trong Tiến độ của tôi.</li></ol></details>
<a class="action" href="/lo-trinh?tab=me">Xem bước tiếp theo của tôi</a>
<% when "me" %>
<h2><%= @level.zero? ? "Thành viên mới" : VnRank::NAMES[@level-1] %></h2>
<% if @level<3 %><h3>Tiến tới <%= VnRank::NAMES[@level] %></h3><ul><% VnRank::TARGETS[@level].each do |k,n| %><li><%= VnRank::LABELS[k] %> · <strong><%= @stats[k] %>/<%= n %></strong><%= " · còn thiếu #{n-@stats[k]}" if @stats[k]<n %></li><% end %></ul>
<% if @ready %><%= button_to "Gửi hồ sơ xét #{VnRank::NAMES[@level]}","/lo-trinh",params:actions("rank") %><% else %><a href="/lo-trinh?tab=trials">Tìm người dùng thử</a><% end %><% end %>
<% if @level>0 %><p><a href="/lo-trinh?tab=member&amp;name=<%= @actor.username %>">Trang giải pháp của tôi</a></p><% end %>
<h3>Nộp giải pháp</h3><%= form_tag("/lo-trinh",method: :post) do %><%= hidden_field_tag :kind,"flow" %><%= hidden_field_tag :tab,"me" %><label>Link bài của bạn trong Đã làm với VNBot hoặc Kho skill &amp; workflow<input name="url" required placeholder="https://community.vnbot.run/t/…"></label><label>Lĩnh vực<%= select_tag :area,options_for_select(VnRank::AREAS) %></label><label>Demo, hướng dẫn thực hiện và kết quả<textarea name="note" required minlength="8" maxlength="1800"></textarea></label><button>Nộp để xét duyệt</button><% end %>
<details><summary>Gửi minh chứng hướng dẫn, kết quả hoặc triển khai</summary><% [["coach","Hướng dẫn một người triển khai"],["impact","So sánh trước/sau"],["team","Đội đã vận hành từ 30 ngày"],["mentor","Dìu dắt một Expert"]].each do |k,label| %><h4><%= label %></h4><%= form_tag("/lo-trinh",method: :post) do %><%= hidden_field_tag :kind,k %><%= hidden_field_tag :tab,"me" %>
<% if k=="impact" %><label>Link bài giải pháp đã duyệt<input required name="url"></label><label>Trước khi áp dụng<input required name="before"></label><label>Sau khi áp dụng<input required name="after"></label>
<% else %><label><%= k=="team" ? "Tên tài khoản của người phụ trách đội" : "Tên tài khoản của người được hướng dẫn" %><input required name="peer"></label><% end %>
<% if k=="team" %><label>Tên đội hoặc mã đội dùng để đối chiếu<input required name="team"></label><label>Ngày bắt đầu vận hành<input type="date" required name="start"></label><% end %>
<label>Minh chứng để người liên quan và ban quản trị đối chiếu<textarea name="note" required minlength="8" maxlength="1800"></textarea></label><button>Gửi minh chứng</button><% end; end %></details>
<h3>Yêu cầu bạn xác nhận</h3><% if @confirm.empty? %><p>Chưa có yêu cầu.</p><% end %><% @confirm.each do |r| %><article><strong><%= kind_label(r.kind) %> · <%= r.user.username %></strong><p><%= r.note %></p><p><%= r.details.values.join(" · ") %></p><%= button_to "Tôi xác nhận","/lo-trinh",params:actions("confirm",r.id) %><%= button_to "Từ chối","/lo-trinh",params:actions("decline",r.id) %></article><% end %>
<h3>Phản hồi từ người dùng thử</h3><% if @feedback.empty? %><p>Chưa có kết quả thử.</p><% end %><% @feedback.each do |r| %><p><a href="/t/<%= r.topic_id %>">Bài #<%= r.topic_id %></a> · <%= r.user.username %> · <%= state_label(r.state) %> · <%= r.note %></p><% end %>
<h3>Hồ sơ đã gửi</h3><% @mine.each do |r| %><p><strong><%= kind_label(r.kind) %></strong> · <%= state_label(r.state) %> <%= r.details["title"] || r.note.truncate(100) %></p><% end %>
<% when "trials","verified","member" %>
<% if @tab=="member" %><h2><%= @person.username %> · <%= VnRank::NAMES[@person_level-1] %></h2><p>Giải pháp đã có người khác làm lại thành công.</p><% if @person_level>=2 %><a class="action" href="<%= reg_link(@person) %>">Mời tư vấn</a><% end %>
<% else %><h2><%= tabs[@tab] %></h2><p><%= @tab=="trials" ? "Chọn một workflow, thử theo hướng dẫn rồi ghi lại kết quả hoặc bước bị vướng." : "Các giải pháp của Expert, Master và Guru đã được người khác làm lại thành công." %></p><% end %>
<% if @flows.empty? %><p><%= @tab=="trials" ? "Chưa có workflow đang tuyển người thử ở đây." : "Chưa có giải pháp đủ điều kiện hiển thị." %></p><% end %>
<% @flows.each do |f| %><article><h3><a href="/t/<%= f.topic_id %>"><%= f.topic.title %></a></h3><p><%= f.details["area"] %> · <%= f.user.username %></p>
<% if @tab!="trials" %><a href="/lo-trinh?tab=trials&amp;topic=<%= f.topic_id %>">Dùng thử workflow</a>
<% elsif @actor.nil? %><a href="/login?redirect=/lo-trinh%3Ftab%3Dtrials">Đăng nhập để dùng thử</a>
<% elsif @actor.id==f.user_id %><a href="/lo-trinh?tab=trials&amp;topic=<%= f.topic_id %>">Link mời dùng thử</a>
<% elsif (r=@attempts[f.id]) && %w[trying blocked].include?(r.state) %><%= form_tag("/lo-trinh", method: :post) do %><% actions("trial_result",f.id).each do |k,v| %><%= hidden_field_tag k,v %><% end %><label>Kết quả<select name="outcome"><option value="success">Tôi đã làm lại thành công</option><option value="blocked">Tôi đang gặp vướng mắc</option></select></label><label>Đầu ra thực tế hoặc bước bị vướng<textarea required minlength="8" name="note" maxlength="1800"></textarea></label><button>Gửi kết quả</button><% end %>
<% elsif r && r.state!="rejected" %><strong><%= state_label(r.state) %></strong><% else %><%= button_to "Tôi muốn thử workflow này","/lo-trinh",params:actions("trial",f.id) %><% end %></article><% end %>
<% when "directory" %><h2>Danh bạ chuyên gia</h2><form method="get"><input type="hidden" name="tab" value="directory"><label>Lĩnh vực<%= select_tag :area,options_for_select(["Tất cả"]+VnRank::AREAS,params[:area]) %></label><button>Lọc chuyên gia</button></form>
<% if @people.empty? %><p>Chưa có Master hoặc Guru trong danh sách này.</p><% end %><% @people.each do |u| %><article><a href="/lo-trinh?tab=member&amp;name=<%= u.username %>"><%= u.username %></a> · <%= VnRank::NAMES[VnRank.level(u)-1] %> · <a href="<%= reg_link(u) %>">Mời tư vấn</a></article><% end %>
<% when "events","briefs" %><h2><%= tabs[@tab] %></h2><% event=@tab=="events"; rows=event ? @events : @briefs %>
<% if (event && @level>=2) || (!event && @actor.staff?) %><details><summary><%= event ? "Đề xuất buổi thực hành" : "Đăng đề bài dành cho Guru" %></summary><%= form_tag("/lo-trinh",method: :post) do %><% actions(event ? "workshop" : "brief").each do |k,v| %><%= hidden_field_tag k,v %><% end %><label>Tiêu đề<input name="title" required maxlength="130"></label><label><%= event ? "Ngày tổ chức" : "Hạn nhận đề xuất" %><input type="date" name="date" required></label><label><%= event ? "Giờ Việt Nam, hình thức tham dự và nội dung" : "Nhu cầu và phạm vi được phép chia sẻ" %><textarea name="note" required minlength="8" maxlength="1800"></textarea></label><% unless event %><label><input type="checkbox" name="consent" value="yes" required>Doanh nghiệp đã đồng ý chia sẻ nội dung này với nhóm Guru.</label><% end %><button><%= event ? "Gửi lịch để duyệt" : "Đăng đề bài" %></button><% end %></details><% end %>
<% if rows.empty? %><p><%= event ? "Chưa có buổi thực hành đã xác nhận lịch." : "Chưa có đề bài đang nhận đề xuất." %></p><% end %><% rows.each do |r| %><article id="item-<%= r.id %>"><h3><%= r.details["title"] %></h3><p><%= r.user.username %> · <%= r.details["date"] %></p><p class="lines"><%= r.note %></p>
<% if event %><% if !@actor %><a href="/login?redirect=/lo-trinh%3Ftab%3Devents">Đăng nhập để đăng ký</a><% elsif @joins.include?(r.id) %><strong>Đã đăng ký</strong><% else %><%= button_to "Đăng ký tham dự","/lo-trinh",params:actions("join",r.id) %><% end %><% if @participants[r.id] %><p>Thành viên đăng ký · <%= @participants[r.id].map{|a| a.user.username}.join(", ") %></p><% end %>
<% else %><% if @level>=3 && !@offers.fetch(r.id,[]).any?{|o| o.user_id==@actor.id} %><%= form_tag("/lo-trinh",method: :post) do %><% actions("apply",r.id).each do |k,v| %><%= hidden_field_tag k,v %><% end %><label>Đề xuất hợp tác<textarea name="note" required minlength="8"></textarea></label><button>Gửi đề xuất cho AIKING</button><% end %><% end %><% @offers.fetch(r.id,[]).each do |o| %><p><%= o.user.username %> · <%= o.note %></p><% end; end %></article><% end %>
<% when "review" %><h2>Hồ sơ chờ duyệt</h2><p>Đối chiếu demo và kết quả trước khi duyệt. Admin xét danh hiệu sau khi hệ thống kiểm tra đủ điều kiện. Mỗi đội và trường hợp trước/sau phải độc lập.</p><% if @queue.empty? %><p>Chưa có hồ sơ chờ duyệt.</p><% end %>
<% @queue.each do |r| %><article><h3><%= kind_label(r.kind) %> · <%= r.user.username %></h3><p class="lines"><%= r.note %></p><% if r.topic_id %><a href="/t/<%= r.topic_id %>">Mở bài minh chứng</a><% end %><p><%= r.details.values.join(" · ") %> <%= "· Người xác nhận: #{User.find_by(id:r.peer_id)&.username}" if r.peer_id %></p>
<% if r.kind=="rank" %><ul><% VnRank.stats(r.user).each do |k,n| %><li><%= VnRank::LABELS[k] %> · <%= n %></li><% end %></ul><% end %>
<% if r.user_id!=@actor.id && r.peer_id!=@actor.id && (r.kind!="rank" || @actor.admin?) %><%= button_to "Duyệt","/lo-trinh",params:actions("approve",r.id) %><%= button_to "Yêu cầu bổ sung","/lo-trinh",params:actions("reject",r.id) %><% end %></article><% end %>
<% end %></main></body></html>
